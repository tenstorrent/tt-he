# Build directories and generated runtime artifacts
build/
device/build/
# ctest writes its scratch to <cwd>/Testing, so running it from the repo root instead of
# `ctest --test-dir build` drops an empty Testing/Temporary here (which is how it got committed).
Testing/
# tt-metalium writes profiler/watcher/inspector output to <cwd>/generated, so it lands wherever the
# binary was launched from -- device/generated, device/he/generated, or the repo root. Ignore all of them
# (the old `device/generated/`-only rule is why device/he/generated was tracked and churned every run).
generated/


# Local compiled test binaries

# Common editor/cache files
.cache/
.vscode/
*.swp
__pycache__/
*.py[cod]

# Generated HE test vectors (regenerate via algorithm/he/gen_*.py)
device/*.bin

# Machine-specific dependency config (generated by tools/setup.sh)
config.local.env

# Verification snapshots from tools/bench/baseline_sweep.sh (large, machine-specific)
.baselines/*.txt
!.baselines/README.md

# Generated PIR demo artifacts (7.6 GB): rebuild with encode_db / gen_query65536.py, never commit.
reference/pir/*.pir
reference/pir/*.fold
reference/pir/db65536.txt
reference/pir/query*.bin

# Generated by reference/ntt/example.py (export_json) -- ~1 MB, rebuilt by running it.
reference/ntt/example_ntt.json

# Experiment case files for exp_tb001b / exp_tg000 -- 5.8 MB, and their own binaries
# regenerate them (TB001B_GEN=<path> / TG000_GEN=<path>). Both experiments are labelled
# `study`, so neither the gate nor CI ever opens these.
reference/he/tb001b_case.bin
reference/he/tg000_case.bin

# Compiler viz/dispatch output. compiler/generated/ is already ignored for the same kinds of
# file; these five sat tracked at the top level from before that rule. Nothing reads them --
# regenerate with viz.py / mlir_viz.py / sched_viz.py / codegen_draft.py.
compiler/ctmul_viz.html
compiler/mlir_dag.html
compiler/sched_gantt.html
compiler/ctmul_dispatch.json
compiler/ctmul_dispatch.cpp.txt
# sweep_cases.py output; nothing reads it.
compiler/cases.json
