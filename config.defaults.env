# config.defaults.env — committed defaults. DO NOT put machine-specific paths here.
#
# Precedence (first wins):
#   1. the environment          TT_METALIUM_PREFIX=... cmake ...
#   2. config.local.env         per-machine, gitignored -- the ONE file a new machine edits
#   3. this file                documented defaults
#
# Create config.local.env by running:  sh tools/setup.sh
# Check an existing setup with:        sh tools/doctor.sh
#
# Format is plain KEY=VALUE so that both shell (`.`-source) and CMake (file(STRINGS)) can read it
# without any tooling. No spaces around `=`, no shell expansion, no quotes needed.

# Where tt-metalium is INSTALLED. Empty = autodetect, trying in order:
#   /usr/local, $HOME/work/ttm-install, <repo>/../ttm-install
# A valid prefix contains BOTH lib/cmake/tt-metalium/tt-metalium-config.cmake AND libexec/tt-metalium.
# NOTE: a tt-metal *build tree* (build_Release) is NOT a valid prefix -- Metalium.cmake is generated by
# `cmake --install`. Use tools/../tools/install_ttmetalium.sh to make a prefix from a build tree.
TT_METALIUM_PREFIX=

# tt-metalium version this repo is known to work with. The doctor WARNS on mismatch, never fails:
# a newer SDK usually works, but if kernels suddenly fail to compile, this is the first thing to check.
TT_METALIUM_VERSION_EXPECTED=0.76

# Interpreter used for the Python goldens / reference models.
# Point this at a conda env (recommended) or any interpreter that has numpy:
#     conda env create -f environment.yml && conda activate tt-he
#     echo "PYTHON=$(which python)" >> config.local.env
# Everything that runs Python -- including tools/doctor.sh -- uses this value, so there is nothing
# to remember to activate.
PYTHON=python3

# Default CMake build type for device/build.
BUILD_TYPE=Release
